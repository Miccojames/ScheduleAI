# Server
PORT=5000

# Database
# Local dev: run `npm run db:start` first (embedded Postgres on port 5433).
# Production: use your managed Postgres connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5433/scheduleai

# Auth — change this in production!
JWT_SECRET=change-me-in-production

# Frontend origin allowed by CORS and the Origin check
FRONTEND_URL=http://localhost:3000

# AI provider — optional in dev; free key from https://aistudio.google.com/apikey
# When empty the MOCK provider is used
GEMINI_API_KEY=

# Optional: Gemini vision model override (default: gemini-3.8-flash)
GEMINI_MODEL=

# Optional: Gemini model for the assistant chat (default: gemini-3.1-flash-lite —
# ~1.5s/call; 3.8-flash is 33s+ and often times out on chat turns)
GEMINI_CHAT_MODEL=

# Directory for uploaded schedule images (gitignored)
UPLOAD_DIR=./uploads

# Optional: "true"/"false" — when unset, mock fallback is allowed in
# development and disabled in production.
AI_ALLOW_MOCK_FALLBACK=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# When empty, push notifications are disabled (endpoints return 503).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@scheduleai.local

# Optional SMTP — when SMTP_HOST is empty, verification codes and
# password-reset links are printed to the server console instead of
# emailed (dev mode). On Render's free tier use port 2525 (e.g.
# smtp-relay.brevo.com): outbound 25/465/587 are blocked there.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ScheduleAI <no-reply@scheduleai.local>
