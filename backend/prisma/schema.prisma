// Prisma 7: the generator must NOT use "-js" suffix and MUST declare an output path.
// The client is generated as TypeScript source into src/generated/prisma (gitignored)
// and imported app-wide as `../generated/prisma/client`.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  moduleFormat    = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

// Prisma 7: the datasource has no `url = env(...)` here — the connection string
// comes from prisma.config.ts (see repo root).
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedules Schedule[]
  uploads   UploadedSchedule[]
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ScheduleEntry[]
  // When a schedule is deleted, uploads keep their image file but lose the link (SetNull).
  uploads UploadedSchedule[]

  @@index([userId])
}

model ScheduleEntry {
  id          String      @id @default(cuid())
  scheduleId  String
  subject     String
  instructor  String?
  room        String?
  day         DayOfWeek
  startTime   String // "HH:MM" 24-hour — stored as text so we keep the exact contract format
  endTime     String
  color       String
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([scheduleId, day])
}

model UploadedSchedule {
  id              String           @id @default(cuid())
  userId          String
  scheduleId      String?
  imagePath       String
  fileName        String
  fileSize        Int
  processingStatus ProcessingStatus @default(PENDING)
  error           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
