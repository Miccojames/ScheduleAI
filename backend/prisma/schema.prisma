// Prisma 7: the generator must NOT use "-js" suffix and MUST declare an output path.
// The client is generated as TypeScript source into src/generated/prisma (gitignored)
// and imported app-wide as `../generated/prisma/client`.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  moduleFormat    = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

// Prisma 7: the datasource has no `url = env(...)` here — the connection string
// comes from prisma.config.ts (see repo root).
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Notification preferences (lead time before a class starts, opt-in flag)
  reminderLeadMinutes Int      @default(10)
  notificationsEnabled Boolean @default(false)
  // IANA timezone captured from the browser (e.g. "Asia/Manila") — used by the
  // reminder job to compute class start times in the user's local time.
  timezone String?

  schedules           Schedule[]
  uploads             UploadedSchedule[]
  passwordResets      PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  notificationLogs    NotificationLog[]
}

// Single-use, hashed password-reset tokens (SHA-256 of the raw token).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Web Push subscription (one row per browser/device).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per (user, entry, local calendar day) already reminded — prevents
// duplicate push notifications when the reminder job ticks more than once.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  fireDate  String // "YYYY-MM-DD" in the user's timezone
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId, fireDate])
  @@index([userId])
}

model Schedule {
  id        String    @id @default(cuid())
  userId    String
  name      String
  // Optional academic-term window: entries only apply within [startDate, endDate].
  // Null = open-ended (legacy behavior).
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ScheduleEntry[]
  // When a schedule is deleted, uploads keep their image file but lose the link (SetNull).
  uploads UploadedSchedule[]

  @@index([userId])
}

model ScheduleEntry {
  id          String      @id @default(cuid())
  scheduleId  String
  subject     String
  instructor  String?
  room        String?
  day         DayOfWeek
  startTime   String // "HH:MM" 24-hour — stored as text so we keep the exact contract format
  endTime     String
  color       String
  notes       String?
  // Event kind: class | work | personal | other (schedule is not class-only).
  kind        String      @default("class")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Recurring-class exceptions: ISO dates ("YYYY-MM-DD") on which this class
  // does NOT meet (holidays, cancelled sessions).
  exceptionDates String[] @default([])
  // One-off events (exams, deadlines): when isOneOff is true, `date` carries
  // the single calendar day and the weekly `day` field mirrors its weekday.
  isOneOff Boolean   @default(false)
  date     DateTime?

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([scheduleId, day])
}

model UploadedSchedule {
  id              String           @id @default(cuid())
  userId          String
  scheduleId      String?
  imagePath       String
  fileName        String
  fileSize        Int
  processingStatus ProcessingStatus @default(PENDING)
  /// Extraction outcome for background processing: { entries: [...], fallback: boolean }
  result          Json?
  /// Which provider produced `result` ("gemini" | "mock").
  provider        String?
  error           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
